@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="form-box">
  <h2>Instructor Login</h2>
  @if (TempData["Msg"] != null)
  {
    <div class="alert">@TempData["Msg"]</div>
  }
  <form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
 
    <input asp-for="EmailOrId" placeholder="Email or Instructor ID" />
    <span asp-validation-for="EmailOrId" class="field-error"></span>
 
    <input asp-for="Password" placeholder="Password" />
    <span asp-validation-for="Password" class="field-error"></span>
 
    <label><input type="checkbox" id="showPass" /> Show password</label>
    <button type="submit" class="btn btn-block">Login</button>
  </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
 