@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="form-box">
    <h2>Instructor Registration</h2>
    <form asp-action="Register" method="post" id="regForm">
        <input asp-for="InstructorId" placeholder="Instructor ID" />
        <span asp-validation-for="InstructorId" class="field-error"></span>
 
        <input asp-for="FirstName" placeholder="First Name" />
        <span asp-validation-for="FirstName" class="field-error"></span>
 
        <input asp-for="LastName" placeholder="Last Name" />
        <span asp-validation-for="LastName" class="field-error"></span>
 
        <input asp-for="Email" placeholder="Email" />
        <span asp-validation-for="Email" class="field-error"></span>
 
        <input asp-for="Password" placeholder="Password" />
        <span asp-validation-for="Password" class="field-error"></span>
 
        <input asp-for="ConfirmPassword" placeholder="Confirm Password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
 
        <label><input type="checkbox" id="showPass" /> Show password</label>
        <p id="msg" class="error"></p>
        <button type="submit" class="btn btn-block">Register</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
