@model Instructor
@{
    ViewData["Title"] = "Instructor Details";
}
<div class="form-box wide">
    <h2>Instructor Details</h2>
    <table class="data">
        <tr><th>@Html.DisplayNameFor(m => m.FullName)</th><td>@Model.FullName</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.Age)</th><td>@Model.Age</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.Address)</th><td>@Model.Address</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.Designation)</th><td>@Model.Designation</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.Gender)</th><td>@Model.Gender</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.ContactNumber)</th><td>@Model.ContactNumber</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.Majorship)</th><td>@Model.Majorship</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.BachelorDegree)</th><td>@Model.BachelorDegree</td></tr>
        <tr><th>@Html.DisplayNameFor(m => m.EmailAddress)</th><td>@Model.EmailAddress</td></tr>
    </table>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
