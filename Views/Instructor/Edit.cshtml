@model Instructor
@{
    ViewData["Title"] = "Edit Instructor";
}
<div class="form-box wide">
    <h2>Edit Instructor</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />     @* tells the controller which record *@
        <partial name="_InstructorForm" />
        <button type="submit" class="btn btn-block">Update Instructor</button>
        <a asp-action="Index" class="btn btn-secondary btn-block">Cancel</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
